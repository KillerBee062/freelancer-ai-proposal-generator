# =============================================
# Backend environment variables
# =============================================

# Gemini API key — get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Database connection URL
# Local dev (default):  sqlite:///app.db
# Turso production:     libsql://your-db-name.turso.io?authToken=your-token
# Postgres:             postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///app.db

# Frontend origin for CORS (set to your Vercel URL in production)
FRONTEND_ORIGIN=http://localhost:5173

# =============================================
# Frontend environment variables (Vite)
# =============================================
# Set VITE_API_URL in Vercel project settings, NOT here.
# Local dev default is http://localhost:8000 (auto-detected).
# VITE_API_URL=https://your-render-app.onrender.com
